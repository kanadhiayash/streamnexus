  "ciCheckPrefix": "SNX / ",
  "fixtureIds": {
    "prefix": "SNX-TITLE",
    "start": 1,
    "end": 50,
    "padding": 3
  },
  "diagnosticPolicy": {
    "auditEventPattern": "^SNX\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
    "prohibitedFields": [
      "email",
      "password",
      "token",
      "cookie",
      "sessionId",
      "authorization"
    ],
    "publicMessageRule": "Validation IDs may appear in internal evidence and logs but must not replace clear user-facing messages."
  },
  "validations": [
