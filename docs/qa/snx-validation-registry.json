    "IA",
    "UI",
    "A11Y",
    "SEC",
    "CI",
    "DATA",
    "PARTNER",
    "ADMIN",
    "RELEASE",
    "BRAND"
  ],
  "ciCheckPrefix": "SNX / ",
  "fixtureIds": {
    "prefix": "SNX-TITLE",
    "start": 1,
    "end": 50,
    "padding": 3
  },
  "diagnosticPolicy": {
    "auditEventPattern": "^SNX\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
