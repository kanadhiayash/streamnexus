{
  "schemaVersion": "1.0.0",
  "productId": "SNX",
  "workstreamPattern": "^SNX-[0-9]{3}$",
  "validationPattern": "^SNX-(AUTH|ACCESS|CAPACITY|FIXTURE|IA|UI|A11Y|SEC|CI|DATA|PARTNER|ADMIN|RELEASE|BRAND)-[0-9]{3}$",
  "testTitlePattern": "^\\[SNX-(AUTH|ACCESS|CAPACITY|FIXTURE|IA|UI|A11Y|SEC|CI|DATA|PARTNER|ADMIN|RELEASE|BRAND)-[0-9]{3}\\] .+$",
  "approvedAreas": [
    "AUTH",
