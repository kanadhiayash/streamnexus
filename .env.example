# Copy this file to .env for local development.
# Never commit real secrets or production database credentials.

PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/streamnexus
SESSION_SECRET=replace-with-a-long-random-string

# Local demo data is seeded by default in development.
# In production, demo data is skipped unless this is explicitly set to true.
SEED_DEMO_DATA=true

# Development-only demo account defaults. Use strong custom values for any deployed demo.
DEMO_ADMIN_EMAIL=admin@gmail.com
DEMO_ADMIN_PASSWORD=admin
DEMO_STREAMER_EMAIL=streamer@gmail.com
DEMO_STREAMER_PASSWORD=streamer

# Login rate-limit tuning.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Local load-test thresholds.
LOAD_TEST_ITERATIONS=40
LOAD_TEST_MAX_AVG_MS=250
LOAD_TEST_MAX_P95_MS=750
