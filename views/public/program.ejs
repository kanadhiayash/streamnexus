<section class='public-page'>
  <div class='page-toolbar'>
    <div>
      <p class='eyebrow'>Program</p>
      <h1><%= label %></h1>
      <p class='muted-copy'>A fictional public screening program with simulated licence availability and access windows.</p>
    </div>
    <a href='/catalog' class='btn btn-secondary'>Catalog</a>
  </div>
  <% if (!contents || contents.length === 0) { %>
    <div class='empty-state' role='status'>
      <p>No published titles are attached to this program yet.</p>
      <a href='/catalog' class='btn btn-primary empty-action'>Browse Catalog</a>
    </div>
  <% } else { %>
    <div class='grid poster-grid'>
      <% contents.forEach(content => { %>
        <article class='card title-card'>
          <img class='content-poster' src='<%= content.image || "/images/default.svg" %>' alt='<%= content.posterAlt || content.title %>' loading='lazy' data-fallback-src='/images/default.svg' />
          <div class='card-content'>
            <p class='meta-line'><%= content.type.toUpperCase() %> / <%= content.genre || 'General' %></p>
            <h2><%= content.title %></h2>
            <p><%= content.shortDescription || content.description || '' %></p>
            <p class='capacity-copy'><%= content.capacity.remaining %> of <%= content.capacity.rentalLimit %> simulated licences open.</p>
          </div>
          <div class='card-footer'>
            <a href='<%= content.detailUrl %>' class='btn btn-primary'>View Screening</a>
          </div>
        </article>
      <% }); %>
    </div>
  <% } %>
  <section class='access-panel section-spacer' aria-labelledby='program-access-heading'>
    <h2 id='program-access-heading'><%= accessExplanation.headline %></h2>
    <p><%= accessExplanation.summary %></p>
    <a href='/access' class='btn btn-secondary'>Read Access Details</a>
  </section>
</section>
