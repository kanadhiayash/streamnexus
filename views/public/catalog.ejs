<section>
  <div class='page-toolbar'>
    <div>
      <p class='eyebrow'>Public catalog</p>
      <h1>Curated Screenings</h1>
    </div>
    <% if (!user) { %>
      <a href='/login' class='btn btn-primary'>Sign In</a>
    <% } %>
  </div>

  <% if (!contents || contents.length === 0) { %>
    <div class='empty-state' role='status'>
      <p>No public titles are available right now.</p>
    </div>
  <% } else { %>
    <div class='grid'>
      <% contents.forEach(content => { %>
        <article class='card'>
          <img class='content-poster' src='<%= content.image || "/images/default.svg" %>' alt='<%= content.title %>' loading='lazy' data-fallback-src='/images/default.svg' />
          <div class='card-content'>
            <p class='meta-line'><%= content.type.toUpperCase() %> / <%= content.genre || 'General' %></p>
            <h2><%= content.title %></h2>
            <p><%= content.description || content.shortDescription || '' %></p>
          </div>
          <div class='card-footer'>
            <a href='/titles/<%= encodeURIComponent(content.slug || content._id) %>' class='btn btn-primary'>View Title</a>
          </div>
        </article>
      <% }); %>
    </div>
  <% } %>
</section>
