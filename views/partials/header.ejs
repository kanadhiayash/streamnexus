<header class="nav" role="banner">
  <a class="brand" href="/" aria-label="StreamNexus home">
    <img class="brand-logo-mark" src="/brand/streamnexus-mark.svg" alt="" width="34" height="34" aria-hidden="true" />
    <img class="brand-logo-lockup" src="/brand/streamnexus-lockup-horizontal-dark.svg" alt="" width="196" height="48" aria-hidden="true" />
  </a>
  <nav role="navigation" aria-label="Main navigation">
    <% if (user) { %>
      <% if (user.role === 'admin') { %>
        <a href="/admin/dashboard" aria-label="Admin Dashboard">Admin Dashboard</a>
        <a href="/admin/content" aria-label="Manage Content">Content</a>
      <% } else { %>
        <a href="/home" aria-label="Browse available titles">Catalog</a>
        <a href="/my-list" aria-label="Your list">My List</a>
        <a href="/my-access" aria-label="Your active rentals">Rentals</a>
      <% } %>
      <form class="logout-form" method="post" action="/logout" role="form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" aria-label="Sign out">Logout</button>
      </form>
    <% } else { %>
      <a href="/signup" aria-label="Create a member account">Sign Up</a>
      <a href="/login" aria-label="Sign in to your account">Login</a>
    <% } %>
  </nav>
</header>
