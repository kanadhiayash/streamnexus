<%
  const safeContents = contents || [];
  const modalPayload = safeContents.map(content => ({
    id: content._id.toString(),
    title: content.title,
    type: content.type,
    description: content.description || '',
    price: Number(content.price || 0).toFixed(2),
    image: content.image || '/images/default.svg',
    genre: content.genre || 'General',
    duration: content.duration || '',
    cast: content.cast || '',
    rating: Number(content.rating || 0).toFixed(1),
    available: !!content.available,
    isShortlisted: !!content.isShortlisted,
    capacity: content.capacity || { rentalLimit: content.rentalLimit || 20, activeRentals: 0, remaining: content.rentalLimit || 20, isFull: false },
    detailUrl: `/titles/${content._id}`,
    rentUrl: `/titles/${content._id}/review`,
    shortlistUrl: `/titles/${content._id}/${content.isShortlisted ? 'shortlist/remove' : 'shortlist'}`,
  }));
  const modalJson = JSON.stringify(modalPayload).replace(/</g, '\\u003c');
%>

<section class='browse-shell'>
  <% if (typeof signedUp !== 'undefined' && signedUp) { %>
    <section class='component-card onboarding-panel' aria-labelledby='onboarding-heading'>
      <div>
        <p class='eyebrow'>Welcome orientation</p>
        <h2 id='onboarding-heading'>Your member workspace is ready</h2>
        <p>Start with discovery, save titles to My List, then activate simulated access when a title has licence capacity.</p>
      </div>
      <div class='onboarding-actions'>
        <a href='/my-list' class='btn btn-secondary'>Open My List</a>
        <a href='/access' class='btn btn-secondary'>Review Access Model</a>
      </div>
    </section>
  <% } %>

  <% const home = typeof memberHome !== 'undefined' ? memberHome : null; %>
  <% if (home) { %>
    <section class='member-home' aria-labelledby='member-home-heading'>
      <div class='page-toolbar'>
        <div>
          <p class='eyebrow'>Member workspace</p>
          <h1 id='member-home-heading'>Member Home</h1>
          <p class='muted-copy'>
            <% if (home.state === 'fresh') { %>
              Start by saving a title or activating a simulated access pass. Discovery below is ordered by editorial fixture data.
            <% } else { %>
              Your saved titles, active access, and curated discovery are gathered here from current account state.
            <% } %>
          </p>
        </div>
        <div class='actions'>
          <a href='/my-access' class='btn btn-primary'>My Access</a>
          <a href='/my-list' class='btn btn-secondary'>My List</a>
        </div>
      </div>

      <div class='member-home-grid'>
        <section class='component-card member-module' aria-labelledby='active-access-heading'>
          <div class='section-heading'>
            <div>
              <p class='eyebrow'>Access</p>
              <h2 id='active-access-heading'>Active Access</h2>
            </div>
            <a href='/my-access' class='btn btn-secondary btn-sm'>View All</a>
          </div>
          <% if (home.activeAccess.length > 0) { %>
            <div class='mini-list'>
              <% home.activeAccess.forEach(rental => { %>
                <a href='<%= rental.confirmationHref || "/my-access" %>' class='mini-poster member-link-card' aria-label='Open access details for <%= rental.title %>'>
                  <img src='<%= rental.image %>' alt='' data-fallback-src='/images/default.svg' />
                  <span>
                    <strong><%= rental.title %></strong>
                    <small><%= rental.daysRemaining !== null ? `${rental.daysRemaining} days remaining` : 'Access window active' %></small>
                  </span>
                </a>
              <% }); %>
            </div>
          <% } else { %>
            <div class='empty-state compact' role='status'>
              <p>No active access yet.</p>
              <a href='/home#browse-titles' class='btn btn-primary btn-sm'>Browse Titles</a>
            </div>
          <% } %>
        </section>

        <section class='component-card member-module' aria-labelledby='expiring-heading'>
          <div class='section-heading'>
            <div>
              <p class='eyebrow'>Priority</p>
              <h2 id='expiring-heading'>Expiring Soon</h2>
            </div>
          </div>
          <% if (home.expiringSoon.length > 0) { %>
            <div class='mini-list'>
              <% home.expiringSoon.forEach(rental => { %>
                <a href='<%= rental.confirmationHref || "/my-access" %>' class='mini-poster member-link-card' aria-label='Review expiring access for <%= rental.title %>'>
                  <img src='<%= rental.image %>' alt='' data-fallback-src='/images/default.svg' />
                  <span>
                    <strong><%= rental.title %></strong>
                    <small><%= rental.daysRemaining %> days remaining</small>
                  </span>
                </a>
              <% }); %>
            </div>
          <% } else { %>
            <div class='empty-state compact' role='status'>
              <p>No access windows are inside the seven-day priority range.</p>
              <a href='/my-access' class='btn btn-secondary btn-sm'>Open My Access</a>
            </div>
          <% } %>
        </section>

        <section class='component-card member-module' aria-labelledby='my-list-preview-heading'>
          <div class='section-heading'>
            <div>
              <p class='eyebrow'>Saved</p>
              <h2 id='my-list-preview-heading'>My List Preview</h2>
            </div>
            <a href='/my-list' class='btn btn-secondary btn-sm'>Open List</a>
          </div>
          <% if (home.myListPreview.length > 0) { %>
            <div class='mini-list'>
              <% home.myListPreview.forEach(item => { %>
                <a href='<%= item.detailUrl %>' class='mini-poster member-link-card' aria-label='Open saved title <%= item.title %>'>
                  <img src='<%= item.image || "/images/default.svg" %>' alt='' data-fallback-src='/images/default.svg' />
                  <span>
                    <strong><%= item.title %></strong>
                    <small><%= item.genre || 'General' %> / <%= item.capacity.remaining %> licences open</small>
                  </span>
                </a>
              <% }); %>
            </div>
          <% } else { %>
            <div class='empty-state compact' role='status'>
              <p>Saved titles will appear here.</p>
              <a href='/home#browse-titles' class='btn btn-primary btn-sm'>Find Titles</a>
            </div>
          <% } %>
        </section>
      </div>

      <% if (home.sponsoredScreening) { %>
        <section class='access-panel member-spotlight' aria-labelledby='sponsored-screening-heading'>
          <div>
            <p class='eyebrow'><%= home.sponsoredScreening.eyebrow %></p>
            <h2 id='sponsored-screening-heading'><%= home.sponsoredScreening.title %></h2>
            <p><%= home.sponsoredScreening.body %></p>
          </div>
          <p><%= home.sponsoredScreening.meta %></p>
          <a href='<%= home.sponsoredScreening.href %>' class='btn btn-primary'>Open Screening</a>
        </section>
      <% } %>

      <section class='member-rail-section' aria-labelledby='program-rail-heading'>
        <div class='section-heading'>
          <div>
            <p class='eyebrow'>Programs</p>
            <h2 id='program-rail-heading'>Featured Programs</h2>
          </div>
        </div>
        <div class='rail-grid member-rail'>
          <% home.programs.forEach(program => { %>
            <a href='<%= program.href %>' class='component-card discovery-card member-link-card' aria-label='Open <%= program.label %>'>
              <p class='eyebrow'><%= program.titles.length %> title<%= program.titles.length === 1 ? '' : 's' %></p>
              <h3><%= program.label %></h3>
              <p>Deterministic grouping from fixture program metadata.</p>
            </a>
          <% }); %>
        </div>
      </section>

      <section class='member-rail-section' aria-labelledby='new-title-heading'>
        <div class='section-heading'>
          <div>
            <p class='eyebrow'>New to catalog</p>
            <h2 id='new-title-heading'>New Titles</h2>
          </div>
        </div>
        <div class='rail-grid member-rail'>
          <% home.newTitles.forEach(item => { %>
            <a href='<%= item.detailUrl %>' class='mini-poster member-link-card' aria-label='Open new title <%= item.title %>'>
              <img src='<%= item.image || "/images/default.svg" %>' alt='' data-fallback-src='/images/default.svg' />
              <span>
                <strong><%= item.title %></strong>
                <small><%= item.genre || 'General' %> / <%= item.accessMode.replace('_', ' ') %></small>
              </span>
            </a>
          <% }); %>
        </div>
      </section>

      <% home.genreRails.forEach(rail => { %>
        <section class='member-rail-section' aria-labelledby='genre-<%= rail.key %>-heading'>
          <div class='section-heading'>
            <div>
              <p class='eyebrow'>Genre rail</p>
              <h2 id='genre-<%= rail.key %>-heading'><%= rail.label %></h2>
            </div>
            <a href='<%= rail.href %>' class='btn btn-secondary btn-sm'>Filter</a>
          </div>
          <div class='rail-grid member-rail'>
            <% rail.titles.forEach(item => { %>
              <a href='<%= item.detailUrl %>' class='mini-poster member-link-card' aria-label='Open <%= item.title %> from <%= rail.label %>'>
                <img src='<%= item.image || "/images/default.svg" %>' alt='' data-fallback-src='/images/default.svg' />
                <span>
                  <strong><%= item.title %></strong>
                  <small><%= item.capacity.remaining %> licences open</small>
                </span>
              </a>
            <% }); %>
          </div>
        </section>
      <% }); %>
    </section>
  <% } %>

  <div class='browse-hero carousel' data-carousel>
    <% if (heroItems && heroItems.length > 0) { %>
      <div class='carousel-track'>
        <% heroItems.forEach((item, index) => { %>
          <article class='carousel-slide <%= index === 0 ? "active" : "" %>' data-carousel-slide>
            <img src='<%= item.image %>' alt='' data-fallback-src='/images/default.svg' />
            <div class='hero-copy'>
              <p class='eyebrow'>Featured title</p>
              <h1><%= item.title %></h1>
              <p><%= item.description %></p>
              <div class='hero-actions'>
                <button type='button' class='btn btn-primary' data-modal-content-id='<%= item._id %>'>View Details</button>
                <form method='get' action='/titles/<%= item._id %>/review' class='inline-form'>
                  <button type='submit' class='btn btn-success' <%= !item.available || (item.capacity && item.capacity.isFull) ? 'disabled' : '' %>>Activate Rental</button>
                </form>
              </div>
              <div class='capacity-strip'>
                <span><%= item.type.toUpperCase() %></span>
                <span><%= item.genre || 'General' %></span>
                <span><%= item.capacity ? item.capacity.remaining : 20 %>/<%= item.capacity ? item.capacity.rentalLimit : 20 %> licences open</span>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
      <div class='carousel-controls' aria-label='Featured browse controls'>
        <button type='button' class='icon-btn' data-carousel-prev aria-label='Previous featured title'>Prev</button>
        <button type='button' class='icon-btn' data-carousel-next aria-label='Next featured title'>Next</button>
      </div>
    <% } %>
  </div>

  <div class='page-toolbar browse-toolbar' id='browse-titles'>
    <div>
      <p class='eyebrow'>Member catalog</p>
      <h1>Browse Titles</h1>
    </div>
    <div class='view-toggle' role='group' aria-label='Choose browse view'>
      <button type='button' data-view='grid' data-view-toggle class='active' aria-pressed='true'>Grid</button>
      <button type='button' data-view='list' data-view-toggle aria-pressed='false'>List</button>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class='alert alert-error' role='alert'><%= error %></div>
  <% } %>

  <form class='filter-bar' method='get' action='/home' aria-label='Search, sort, and filter titles'>
    <div class='form-group'>
      <label for='search'>Search</label>
      <input type='text' id='search' name='search' value='<%= search || "" %>' placeholder='Search title, genre, or description' />
    </div>
    <div class='form-group'>
      <label for='type'>Type</label>
      <select id='type' name='type'>
        <option value='' <%= !type ? 'selected' : '' %>>All</option>
        <option value='movie' <%= type === 'movie' ? 'selected' : '' %>>Movies</option>
        <option value='tv' <%= type === 'tv' ? 'selected' : '' %>>TV Series</option>
      </select>
    </div>
    <div class='form-group'>
      <label for='sort'>Sort</label>
      <select id='sort' name='sort'>
        <option value='title' <%= sort === 'title' ? 'selected' : '' %>>Title</option>
        <option value='newest' <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
        <option value='price_asc' <%= sort === 'price_asc' ? 'selected' : '' %>>Price: low to high</option>
        <option value='price_desc' <%= sort === 'price_desc' ? 'selected' : '' %>>Price: high to low</option>
      </select>
    </div>
    <div class='filter-actions'>
      <button type='submit' class='btn btn-primary'>Apply</button>
      <a href='/home' class='btn btn-secondary'>Reset</a>
    </div>
  </form>

  <% if (safeContents.length === 0) { %>
    <div class='empty-state' role='status'>
      <% if (search || type) { %>
        <p>No matching titles found. Try a different search or filter.</p>
      <% } else { %>
        <p>No titles available at the moment. Check back soon.</p>
      <% } %>
    </div>
  <% } else { %>
    <div class='grid poster-grid'>
      <% safeContents.forEach(content => { %>
        <% const capacity = content.capacity || { rentalLimit: content.rentalLimit || 20, activeRentals: 0, remaining: content.rentalLimit || 20, isFull: false }; %>
        <article class='card poster-card' tabindex='0' role='button' data-content-card data-modal-content-id='<%= content._id %>' aria-label='Open details for <%= content.title %>'>
          <img class='content-poster' src='<%= content.image %>' alt='<%= content.title %>' loading='lazy' data-fallback-src='/images/default.svg' />
          <div class='poster-overlay'>
            <span class='status <%= content.available && !capacity.isFull ? "available" : "unavailable" %>'>
              <%= content.available && !capacity.isFull ? 'Available' : 'Full or unavailable' %>
            </span>
          </div>
          <div class='card-content'>
            <p class='meta-line'><%= content.type.toUpperCase() %> / <%= content.genre || 'General' %></p>
            <h3><%= content.title %></h3>
            <p><%= content.description %></p>
            <div class='card-meta-row'>
              <span class='price'>$<%= Number(content.price || 0).toFixed(2) %></span>
              <span><%= capacity.remaining %>/<%= capacity.rentalLimit %> licences</span>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
    <% if (pagination && pagination.totalPages > 1) { %>
      <nav class='pagination' aria-label='Catalog pagination'>
        <a class='btn btn-secondary <%= pagination.hasPrevious ? "" : "disabled" %>' href='/home?search=<%= encodeURIComponent(search || "") %>&type=<%= encodeURIComponent(type || "") %>&sort=<%= encodeURIComponent(sort || "title") %>&page=<%= pagination.previousPage %>'>Previous</a>
        <span>Page <%= pagination.currentPage %> of <%= pagination.totalPages %> / <%= pagination.totalItems %> titles</span>
        <a class='btn btn-secondary <%= pagination.hasNext ? "" : "disabled" %>' href='/home?search=<%= encodeURIComponent(search || "") %>&type=<%= encodeURIComponent(type || "") %>&sort=<%= encodeURIComponent(sort || "title") %>&page=<%= pagination.nextPage %>'>Next</a>
      </nav>
    <% } %>
  <% } %>

  <script type='application/json' id='content-modal-data'><%- modalJson %></script>
  <div class='content-modal' data-content-modal hidden>
    <div class='content-modal-panel' role='dialog' aria-modal='true' aria-labelledby='content-modal-title' tabindex='-1'>
      <button type='button' class='modal-close' data-modal-close aria-label='Close details'>Close</button>
      <img class='modal-poster' data-modal-image src='/images/default.svg' alt='' data-fallback-src='/images/default.svg' />
      <div class='modal-body'>
        <p class='eyebrow' data-modal-meta>Movie</p>
        <h2 id='content-modal-title' data-modal-title>Title</h2>
        <p data-modal-description></p>
        <dl class='details-list'>
          <div><dt>Price</dt><dd data-modal-price></dd></div>
          <div><dt>Rating</dt><dd data-modal-rating></dd></div>
          <div><dt>Runtime</dt><dd data-modal-duration></dd></div>
          <div><dt>Licence availability</dt><dd data-modal-capacity></dd></div>
        </dl>
        <p class='cast-line' data-modal-cast></p>
        <div class='modal-actions'>
          <form method='post' data-modal-shortlist-form>
            <input type='hidden' name='_csrf' value='<%= csrfToken %>' />
            <input type='hidden' name='returnTo' value='/home' data-modal-return-to />
            <button type='submit' class='btn btn-secondary' data-modal-shortlist-button>My List</button>
          </form>
          <form method='get' data-modal-rent-form>
            <button type='submit' class='btn btn-success' data-modal-rent-button>Activate Rental</button>
          </form>
          <a class='btn btn-primary' href='#' data-modal-details-link>Details Page</a>
        </div>
      </div>
    </div>
  </div>
</section>
