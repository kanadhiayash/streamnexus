<section>
  <div class='page-toolbar'>
    <div>
      <p class='eyebrow'>Member access</p>
      <h1>My Access</h1>
    </div>
    <div class='view-toggle' role='group' aria-label='Choose access view'>
      <button type='button' data-view='grid' data-view-toggle class='active' aria-pressed='true'>Grid</button>
      <button type='button' data-view='list' data-view-toggle aria-pressed='false'>List</button>
    </div>
  </div>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class='alert alert-error' role='alert'><%= error %></div>
  <% } %>
  <% if (rented && reference) { %>
    <div class='alert alert-success' role='status'>
      Access pass confirmed. Reference <strong><%= reference %></strong> is active for 45 days.
      <a href='/my-access/ref/<%= encodeURIComponent(reference) %>'>View confirmation</a>
    </div>
  <% } %>
  <% if (returned) { %>
    <div class='alert alert-info' role='status'>
      Access returned. The title licence is available for another member action.
    </div>
  <% } %>
  <% if (rentals.length === 0) { %>
    <div class='empty-state' role='status'>
      <p>No access passes yet. Browse and activate simulated access for your first title.</p>
      <a href='/home' class='btn btn-primary empty-action'>Browse Titles</a>
    </div>
  <% } else { %>
    <section aria-labelledby='active-access-heading'>
      <div class='section-heading'>
        <h2 id='active-access-heading'>Active Access</h2>
        <p><%= active.length %> title<%= active.length === 1 ? '' : 's' %></p>
      </div>
      <% if (active.length === 0) { %>
        <div class='empty-state' role='status'>
          <p>No active access passes. Returned, expired, and cancelled passes stay in History.</p>
        </div>
      <% } else { %>
        <div class='grid'>
          <% active.forEach(r => { %>
            <div class='card'>
              <img class='content-poster' src='<%= r.image %>' alt='<%= r.title %>' loading='lazy' data-fallback-src='/images/default.svg' />
              <div class='card-content'>
                <h3><%= r.title %></h3>
                <p class='rental-status-line'>
                  <strong>Status:</strong>
                  <span class='status available'><%= r.statusLabel %></span>
                </p>
                <p class='supporting-copy'>
                  Reference: <%= r.publicReference || 'Pending' %>
                </p>
                <p class='supporting-copy'>
                  Started: <%= new Date(r.rentedAt || r.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </p>
                <p class='rental-window'>
                  Access until: <%= new Date(r.expiresAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </p>
                <% if (r.expiresWithinSevenDays) { %>
                  <p class='alert alert-warning' role='status'>Access expires within 7 days.</p>
                <% } %>
              </div>
              <div class='card-footer'>
                <% if (r.publicReference) { %>
                  <a class='btn btn-primary' href='<%= r.confirmationHref %>'>Access Details</a>
                <% } %>
                <button type='button' class='btn btn-success' data-checkout-id='<%= r._id %>' aria-label='Return access for <%= r.title %>'>Return Access</button>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </section>

    <section class='section-spacer' aria-labelledby='access-history-heading'>
      <div class='section-heading'>
        <h2 id='access-history-heading'>History</h2>
        <p><%= completed.length %> title<%= completed.length === 1 ? '' : 's' %></p>
      </div>
      <% if (completed.length === 0) { %>
        <div class='empty-state' role='status'>
          <p>No returned, expired, or cancelled access passes yet.</p>
        </div>
      <% } else { %>
        <div class='grid'>
          <% completed.forEach(r => { %>
            <div class='card'>
              <img class='content-poster' src='<%= r.image %>' alt='<%= r.title %>' loading='lazy' data-fallback-src='/images/default.svg' />
              <div class='card-content'>
                <h3><%= r.title %></h3>
                <p class='rental-status-line'>
                  <strong>Status:</strong>
                  <span class='status unavailable'><%= r.statusLabel %></span>
                </p>
                <p class='supporting-copy'>
                  Reference: <%= r.publicReference || 'Legacy access record' %>
                </p>
                <p class='rental-window'>
                  Window ended: <%= r.endedAt ? new Date(r.endedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : new Date(r.expiresAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </p>
              </div>
              <div class='card-footer'>
                <% if (r.publicReference) { %>
                  <a class='btn btn-secondary' href='<%= r.confirmationHref %>'>Details</a>
                <% } else { %>
                  <button type='button' class='btn btn-secondary' disabled>Legacy record</button>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </section>
  <% } %>
</section>
