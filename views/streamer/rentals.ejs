<section>
  <div class='page-toolbar'>
    <h1>My Rentals</h1>
    <div class='view-toggle' role='group' aria-label='Choose rentals view'>
      <button type='button' data-view='grid' data-view-toggle class='active' aria-pressed='true'>Grid</button>
      <button type='button' data-view='list' data-view-toggle aria-pressed='false'>List</button>
    </div>
  </div>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class='alert alert-error' role='alert'><%= error %></div>
  <% } %>
  <% if (rented && reference) { %>
    <div class='alert alert-success' role='status'>
      Rental confirmed. Reference <strong><%= reference %></strong> is active for 45 days.
      <a href='/my-access/ref/<%= encodeURIComponent(reference) %>'>View confirmation</a>
    </div>
  <% } %>
  <% if (rentals.length === 0) { %>
    <div class='empty-state' role='status'>
      <p>No rentals yet. Browse and activate rental access for your first title.</p>
      <a href='/home' class='btn btn-primary empty-action'>Browse Titles</a>
    </div>
  <% } else { %>
    <section aria-labelledby='active-rentals-heading'>
      <div class='section-heading'>
        <h2 id='active-rentals-heading'>Active Access</h2>
        <p><%= active.length %> title<%= active.length === 1 ? '' : 's' %></p>
      </div>
      <% if (active.length === 0) { %>
        <div class='empty-state' role='status'>
          <p>No active rentals. Returned and expired rentals stay in History.</p>
        </div>
      <% } else { %>
        <div class='grid'>
          <% active.forEach(r => { %>
            <div class='card'>
              <img class='content-poster' src='<%= r.contentId && r.contentId.image ? r.contentId.image : "/images/default.svg" %>' alt='<%= r.contentId ? r.contentId.title : "Content" %>' loading='lazy' data-fallback-src='/images/default.svg' />
              <div class='card-content'>
                <h3><%= r.contentId ? r.contentId.title : 'Content Deleted' %></h3>
                <p class='rental-status-line'>
                  <strong>Status:</strong>
                  <span class='status available'>Active rental</span>
                </p>
                <p class='supporting-copy'>
                  Reference: <%= r.publicReference || 'Pending' %>
                </p>
                <p class='supporting-copy'>
                  Started: <%= new Date(r.rentedAt || r.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </p>
                <p class='rental-window'>
                  Access until: <%= new Date(r.expiresAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </p>
                <% if ((new Date(r.expiresAt).getTime() - Date.now()) <= (7 * 24 * 60 * 60 * 1000)) { %>
                  <p class='alert alert-warning' role='status'>Access expires within 7 days.</p>
                <% } %>
              </div>
              <div class='card-footer'>
                <% if (r.publicReference) { %>
                  <a class='btn btn-primary' href='/my-access/ref/<%= encodeURIComponent(r.publicReference) %>'>Confirmation</a>
                <% } %>
                <button type='button' class='btn btn-success' data-checkout-id='<%= r._id %>' aria-label='Return access for <%= r.contentId ? r.contentId.title : "this rental" %>'>Return Access</button>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </section>

    <section class='section-spacer' aria-labelledby='rental-history-heading'>
      <div class='section-heading'>
        <h2 id='rental-history-heading'>History</h2>
        <p><%= completed.length %> title<%= completed.length === 1 ? '' : 's' %></p>
      </div>
      <% if (completed.length === 0) { %>
        <div class='empty-state' role='status'>
          <p>No returned or expired rentals yet.</p>
        </div>
      <% } else { %>
        <div class='grid'>
          <% completed.forEach(r => { %>
            <div class='card'>
              <img class='content-poster' src='<%= r.contentId && r.contentId.image ? r.contentId.image : "/images/default.svg" %>' alt='<%= r.contentId ? r.contentId.title : "Content" %>' loading='lazy' data-fallback-src='/images/default.svg' />
              <div class='card-content'>
                <h3><%= r.contentId ? r.contentId.title : 'Content Deleted' %></h3>
                <p class='rental-status-line'>
                  <strong>Status:</strong>
                  <span class='status unavailable'><%= r.status === 'returned' ? 'Access returned' : r.status %></span>
                </p>
                <p class='supporting-copy'>
                  Reference: <%= r.publicReference || 'Legacy rental' %>
                </p>
                <p class='rental-window'>
                  Window ended: <%= r.endedAt ? new Date(r.endedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : new Date(r.expiresAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </p>
              </div>
              <div class='card-footer'>
                <% if (r.publicReference) { %>
                  <a class='btn btn-secondary' href='/my-access/ref/<%= encodeURIComponent(r.publicReference) %>'>Details</a>
                <% } else { %>
                  <button type='button' class='btn btn-secondary' disabled>Legacy record</button>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </section>
  <% } %>
</section>
