<section>
  <div class='page-toolbar'>
    <div>
      <p class='eyebrow'>Account</p>
      <h1>Account Settings</h1>
    </div>
  </div>
  <div class='details-card'>
    <div class='details-info'>
      <dl class='details-list'>
        <div><dt>Email</dt><dd><%= account.email %></dd></div>
