<section>
  <% const isEditing = content && content._id; %>
  <h1><%= isEditing ? 'Edit Content' : 'Add New Content' %></h1>
  <% if (typeof errors !== 'undefined' && errors) { %>
    <div class='alert alert-error' role='alert'>
      <strong>Validation errors:</strong>
      <ul class='form-error-list'>
        <% errors.forEach(error => { %>
          <li><%= error %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>
  <% if (typeof message !== 'undefined' && message) { %>
    <div class='alert alert-error' role='alert'><%= message %></div>
  <% } %>

  <div class='form-panel'>
    <form method='post' action="<%= action %>" id='contentForm' data-validate-form>
      <input type='hidden' name='_csrf' value='<%= csrfToken %>' />
      <fieldset class='form-fieldset'>
        <legend>Required Information</legend>

        <div class='form-group'>
          <label for='title'>Title <span class='required-marker'>*</span></label>
          <input
            type='text'
            id='title'
            name='title'
            placeholder='e.g., Avatar 2'
            value="<%= content ? content.title : '' %>"
            required
            aria-required='true'
            aria-describedby='title-desc'
          />
          <small id='title-desc' class='form-help'>The title of the movie or TV series</small>
        </div>

        <div class='form-group'>
          <label for='type'>Type <span class='required-marker'>*</span></label>
          <select id='type' name='type' required aria-required='true'>
            <option value=''>Select a type...</option>
            <option value='movie' <% if(content && content.type === 'movie') { %>selected<% } %>>Movie</option>
            <option value='tv' <% if(content && content.type === 'tv') { %>selected<% } %>>TV Series</option>
          </select>
        </div>

        <div class='form-group'>
          <label for='price'>Price ($) <span class='required-marker'>*</span></label>
          <input
            type='number'
            id='price'
            name='price'
            placeholder='9.99'
            step='0.01'
            min='0'
            max='99.99'
            value="<%= content ? content.price : '' %>"
            required
            aria-required='true'
            aria-describedby='price-desc'
          />
          <small id='price-desc' class='form-help'>Rental price in USD</small>
        </div>

        <div class='form-group'>
          <label for='rentalLimit'>Active Rental Limit <span class='required-marker'>*</span></label>
          <input
            type='number'
            id='rentalLimit'
            name='rentalLimit'
            min='1'
            max='50'
            step='1'
            value="<%= content ? (content.rentalLimit || 20) : 20 %>"
            required
            aria-required='true'
            aria-describedby='rental-limit-desc'
          />
          <small id='rental-limit-desc' class='form-help'>Default is 20 active access seats per title.</small>
        </div>
      </fieldset>

      <fieldset class='form-fieldset'>
        <legend>Additional Details</legend>

        <div class='form-group'>
          <label for='description'>Description</label>
          <textarea
            id='description'
            name='description'
            placeholder='Brief description of the content...'
            rows='4'
            aria-describedby='desc-desc'
          ><%= content ? content.description : '' %></textarea>
          <small id='desc-desc' class='form-help'>What is this content about?</small>
        </div>

        <div class='form-group'>
          <label for='genre'>Genre</label>
          <input
            type='text'
            id='genre'
            name='genre'
            placeholder='e.g., Sci-Fi, Drama, Action'
            value="<%= content ? (content.genre || '') : '' %>"
          />
        </div>

        <div class='form-group'>
          <label for='rating'>Rating (0-10)</label>
          <input
            type='number'
            id='rating'
            name='rating'
            placeholder='7.5'
            step='0.1'
            min='0'
            max='10'
            value="<%= content ? (content.rating || '') : '' %>"
          />
        </div>

        <div class='form-group'>
          <label for='duration'>Duration</label>
          <input
            type='text'
            id='duration'
            name='duration'
            placeholder='e.g., 2h 15m'
            value="<%= content ? (content.duration || '') : '' %>"
          />
        </div>

        <div class='form-group'>
          <label for='cast'>Cast</label>
          <input
            type='text'
            id='cast'
            name='cast'
            placeholder='e.g., Actor 1, Actor 2'
            value="<%= content ? (content.cast || '') : '' %>"
          />
        </div>

        <div class='form-group'>
          <label for='image'>Image URL</label>
          <input
            type='text'
            id='image'
            name='image'
            placeholder='https://example.com/image.jpg'
            value="<%= content ? content.image : '' %>"
          />
        </div>
      </fieldset>

      <fieldset class='form-fieldset'>
        <legend>Status</legend>
        <div class='form-group'>
          <label class='form-check'>
            <input
              type='checkbox'
              name='available'
              value='on'
              <% if(!content || content.available) { %>checked<% } %>
            />
            <span>Available for rental</span>
          </label>
        </div>
      </fieldset>

      <div class='form-actions'>
        <button type='submit' class='btn btn-success'>
          <%= isEditing ? 'Update Content' : 'Create Content' %>
        </button>
        <a href='/admin/dashboard' class='btn btn-secondary'>Cancel</a>
      </div>
    </form>
  </div>
</section>
