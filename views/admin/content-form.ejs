<section>
  <% const isEditing = content && content._id; %>
  <h1><%= isEditing ? 'Edit Content' : 'Add New Content' %></h1>
  <% if (typeof errors !== 'undefined' && errors) { %>
    <div class='alert alert-error' role='alert'>
      <strong>Validation errors:</strong>
      <ul style='margin-top: 0.5rem;'>
        <% errors.forEach(error => { %>
          <li><%= error %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>
  <% if (typeof message !== 'undefined' && message) { %>
    <div class='alert alert-error' role='alert'><%= message %></div>
  <% } %>

  <div style='max-width:700px;background:var(--bg-secondary);border:1px solid var(--border-color);padding:2rem;border-radius:12px;margin-top:1.5rem;'>
    <form method='post' action="<%= action %>" id='contentForm' data-validate-form>
      <input type='hidden' name='_csrf' value='<%= csrfToken %>' />
      <!-- Required Fields Section -->
      <fieldset style='border:none;margin-bottom:2rem;'>
        <legend style='font-size:1.1rem;font-weight:600;margin-bottom:1rem;'>Required Information</legend>

        <div class='form-group'>
          <label for='title'>Title <span style='color:var(--accent-red);'>*</span></label>
          <input
            type='text'
            id='title'
            name='title'
            placeholder='e.g., Avatar 2'
            value="<%= content ? content.title : '' %>"
            required
            aria-required='true'
            aria-describedby='title-desc'
          />
          <small id='title-desc' style='color:var(--text-tertiary);'>The title of the movie or TV series</small>
        </div>

        <div class='form-group'>
          <label for='type'>Type <span style='color:var(--accent-red);'>*</span></label>
          <select id='type' name='type' required aria-required='true'>
            <option value=''>Select a type...</option>
            <option value='movie' <% if(content && content.type === 'movie') { %>selected<% } %>>Movie</option>
            <option value='tv' <% if(content && content.type === 'tv') { %>selected<% } %>>TV Series</option>
          </select>
        </div>

        <div class='form-group'>
          <label for='price'>Price ($) <span style='color:var(--accent-red);'>*</span></label>
          <input
            type='number'
            id='price'
            name='price'
            placeholder='9.99'
            step='0.01'
            min='0'
            max='99.99'
            value="<%= content ? content.price : '' %>"
            required
            aria-required='true'
            aria-describedby='price-desc'
          />
          <small id='price-desc' style='color:var(--text-tertiary);'>Rental price in USD</small>
        </div>

        <div class='form-group'>
          <label for='rentalLimit'>Active Rental Limit <span style='color:var(--accent-red);'>*</span></label>
          <input
            type='number'
            id='rentalLimit'
            name='rentalLimit'
            min='1'
            max='50'
            step='1'
            value="<%= content ? (content.rentalLimit || 5) : 5 %>"
            required
            aria-required='true'
            aria-describedby='rental-limit-desc'
          />
          <small id='rental-limit-desc' style='color:var(--text-tertiary);'>Default is 5 active streamers per title.</small>
        </div>
      </fieldset>

      <!-- Optional Details Section -->
      <fieldset style='border:none;margin-bottom:2rem;'>
        <legend style='font-size:1.1rem;font-weight:600;margin-bottom:1rem;'>Additional Details</legend>

        <div class='form-group'>
          <label for='description'>Description</label>
          <textarea
            id='description'
            name='description'
            placeholder='Brief description of the content...'
            rows='4'
            aria-describedby='desc-desc'
          ><%= content ? content.description : '' %></textarea>
          <small id='desc-desc' style='color:var(--text-tertiary);'>What is this content about?</small>
        </div>

        <div class='form-group'>
          <label for='genre'>Genre</label>
          <input
            type='text'
            id='genre'
            name='genre'
            placeholder='e.g., Sci-Fi, Drama, Action'
            value="<%= content ? (content.genre || '') : '' %>"
          />
        </div>

        <div class='form-group'>
          <label for='rating'>Rating (0-10)</label>
          <input
            type='number'
            id='rating'
            name='rating'
            placeholder='7.5'
            step='0.1'
            min='0'
            max='10'
            value="<%= content ? (content.rating || '') : '' %>"
          />
        </div>

        <div class='form-group'>
          <label for='duration'>Duration</label>
          <input
            type='text'
            id='duration'
            name='duration'
            placeholder='e.g., 2h 15m'
            value="<%= content ? (content.duration || '') : '' %>"
          />
        </div>

        <div class='form-group'>
          <label for='cast'>Cast</label>
          <input
            type='text'
            id='cast'
            name='cast'
            placeholder='e.g., Actor 1, Actor 2'
            value="<%= content ? (content.cast || '') : '' %>"
          />
        </div>

        <div class='form-group'>
          <label for='image'>Image URL</label>
          <input
            type='text'
            id='image'
            name='image'
            placeholder='https://example.com/image.jpg'
            value="<%= content ? content.image : '' %>"
          />
        </div>
      </fieldset>

      <!-- Status Section -->
      <fieldset style='border:none;margin-bottom:2rem;'>
        <legend style='font-size:1.1rem;font-weight:600;margin-bottom:1rem;'>Status</legend>
        <div class='form-group'>
          <label style='display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-weight:normal;'>
            <input
              type='checkbox'
              name='available'
              value='on'
              <% if(!content || content.available) { %>checked<% } %>
            />
            <span>Available for rental</span>
          </label>
        </div>
      </fieldset>

      <!-- Actions -->
      <div style='display:flex;gap:1rem;margin-top:2rem;border-top:1px solid var(--border-color);padding-top:2rem;'>
        <button type='submit' class='btn btn-success'>
          <%= isEditing ? 'Update Content' : 'Create Content' %>
        </button>
        <a href='/admin/dashboard' class='btn btn-secondary'>Cancel</a>
      </div>
    </form>
  </div>
</section>
